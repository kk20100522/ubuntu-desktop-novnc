[Unit]
Description=GNOME desktop over Xvfb + x11vnc + noVNC
After=network.target

[Service]
Type=simple
User=gnome
Environment=DISPLAY=:0
Environment=XDG_RUNTIME_DIR=/run/user/1000
Environment=XDG_SESSION_TYPE=x11
Environment=GDK_BACKEND=x11
Environment=MUTTER_DEBUG_FORCE_NO_HW=1
Environment=MUTTER_DEBUG_FORCE_NO_GL=1
PAMName=login
ExecStart=/usr/local/bin/start-gnome-vnc.sh
Restart=always

[Install]
WantedBy=graphical.target
